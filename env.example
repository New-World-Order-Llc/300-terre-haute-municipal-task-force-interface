# Copy values into a secure local environment; do not commit real credentials.
SMTP_HOST=smtp.example.invalid
SMTP_PORT=465
SMTP_USER=replace-with-authorized-smtp-user
SMTP_PASS=replace-with-smtp-password
SYSTEM_EMAIL=replace-with-authorized-sender@example.invalid
CITY_ENDPOINT_EMAIL=replace-with-verified-city-endpoint@example.invalid
WALLET_ANCHOR_ID=0cad6a0d-1462-47eb-853e-17521d57322e
SIGNING_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----REPLACE_WITH_ED25519_PUBLIC_KEY-----END PUBLIC KEY-----"
# Packet generation can use an offline key; the bridge requires a protected signer on its host.
SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----REPLACE_WITH_ED25519_PRIVATE_KEY-----END PRIVATE KEY-----"
RPC_URL=https://replace-with-authorized-json-rpc-endpoint.invalid
BRIDGE_CHAIN_ID=11155111
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
TASKFORCE_ADDRESS=0x0000000000000000000000000000000000000000
BRIDGE_START_BLOCK=0
BRIDGE_CONFIRMATIONS=2
BRIDGE_BLOCK_RANGE=500
# Packets are signed and persisted for review; the bridge does not send email.
PACKET_OUTPUT_DIR=packets
BRIDGE_CURSOR_FILE=.bridge-cursor.json
